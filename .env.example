NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:your_password@localhost:54322/postgres

FRONTEND_ORIGIN=http://localhost:5173

SESSION_SECRET=replace-with-a-random-development-secret

# --- Supabase (server-side only — never expose to the browser) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key-here

# --- Frontend Client Environment (Vite browser app - safe public keys only) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
VITE_API_URL=http://localhost:4000

# --- Reverse proxy (optional) ---
# Set to "1" if behind a single reverse proxy, to allow express-rate-limit
# to read the real client IP from X-Forwarded-For.
# TRUST_PROXY=1